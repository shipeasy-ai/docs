{
  "name": "@shipeasy/docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "predev": "tsx scripts/sync-generated.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-generated.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsx scripts/sync-generated.ts && fumadocs-mdx && tsc --noEmit && pnpm check-cli",
    "check-cli": "tsx scripts/check-cli-mentions.ts",
    "gen": "pnpm gen:api && pnpm gen:sdk",
    "gen:api": "tsx scripts/gen-api-reference.ts",
    "gen:sdk": "tsx scripts/gen-sdk-reference.ts",
    "sync": "tsx scripts/sync-generated.ts",
    "verify:generated": "tsx scripts/verify-generated.ts",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm build && wrangler dev",
    "check-links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@shipeasy/openapi": "^3.2.0",
    "@types/hast": "^3.0.4",
    "fumadocs-core": "16.7.16",
    "fumadocs-mdx": "14.3.0",
    "fumadocs-openapi": "10.8.1",
    "fumadocs-ui": "16.7.16",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mermaid": "^11.14.0",
    "next": "16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.4",
    "wrangler": "^4.83.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
